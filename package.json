{
    "devDependencies": {
        "@eslint/js": "^9.37.0",
        "@vitejs/plugin-react": "^6.1.2",
        "esbuild": "^0.28.2",
        "eslint": "^9.37.0",
        "fs-extra": "^11.3.2",
        "globals": "^16.4.0",
        "htmlhint": "^1.7.1",
        "madge": "^8.0.0",
        "stylelint": "^16.25.0",
        "stylelint-config-recommended": "^17.0.0",
        "vite": "^8.3.4"
    },
    "scripts": {
        "lint:js": "eslint js",
        "lint:css": "stylelint css",
        "lint:html": "htmlhint **/*.html",
        "dev": "npx esbuild js/*.js --bundle --splitting --format=esm --target=es2020 --chunk-names=chunks/[name]-[hash] --outdir=dist --servedir=. --serve=8080",
        "build": "npx esbuild js/*.js --bundle --splitting --format=esm --target=es2020 --chunk-names=chunks/[name]-[hash] --outdir=dist --minify",
        "build:public": "npm run build && node -e \"const fs = require('fs-extra'); fs.ensureDir('public').then(() => Promise.all(['assets', 'css', 'dist', 'index.html', 'dashboard.html'].map((f) => fs.copy(f, 'public/' + f)))).then(() => console.log('✅ Successfully!'));\"",
        "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
    },
    "dependencies": {
        "firebase": "^13.2.0"
    }
}
